MALWARE_SCANNING_ENABLED=false
EVIDENCE_SCANNER_MODE=remote
DEVELOPMENT_FILE_VALIDATION_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
MALWARE_SCANNER_URL=https://your-malware-scanner.example/scan
MALWARE_SCANNER_TOKEN=replace-with-scanner-token
EVIDENCE_WORKER_BATCH_SIZE=5
EVIDENCE_WORKER_IDLE_DELAY_MS=2000
EVIDENCE_WORKER_ERROR_DELAY_MS=10000
DOCUMENT_EXTRACTOR_URL=https://your-document-extractor.example/extract
DOCUMENT_EXTRACTOR_TOKEN=replace-with-extractor-token
EXTRACTION_WORKER_BATCH_SIZE=5
EXTRACTION_WORKER_IDLE_DELAY_MS=2000
EXTRACTION_WORKER_ERROR_DELAY_MS=10000
# Must stay comfortably above 3x EXTRACTION_ENGINE_TIMEOUT_MS below (the adapter may make
# up to three sequential provider calls per request: OpenAI validation, then a Gemini
# primary and fallback attempt). If you raise the adapter's timeout, raise this too.
EXTRACTION_REQUEST_TIMEOUT_MS=200000

# Railway extraction adapter. Keep these server-side and use a different token
# for the worker-to-adapter connection and each provider API key.
EXTRACTION_ADAPTER_TOKEN=
OPENAI_API_KEY=
OPENAI_INVOICE_VALIDATION_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
EXTRACTION_ENGINE_TIMEOUT_MS=60000

# Telegram inbound (service:telegram-inbound). Uses SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# above directly, since it writes evidence artifacts itself rather than going through a
# worker. TELEGRAM_TEST_TENANT_ID is Sprint 10's temporary fixed-tenant routing (see
# docs/SCALING.md "Telegram real tenant mapping" for the deferred per-chat version).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_TENANT_ID=
