MALWARE_SCANNING_ENABLED=false
EVIDENCE_SCANNER_MODE=remote
DEVELOPMENT_FILE_VALIDATION_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
MALWARE_SCANNER_URL=https://your-malware-scanner.example/scan
MALWARE_SCANNER_TOKEN=replace-with-scanner-token
EVIDENCE_WORKER_BATCH_SIZE=5
EVIDENCE_WORKER_IDLE_DELAY_MS=2000
EVIDENCE_WORKER_ERROR_DELAY_MS=10000
DOCUMENT_EXTRACTOR_URL=https://your-document-extractor.example/extract
DOCUMENT_EXTRACTOR_TOKEN=replace-with-extractor-token
EXTRACTION_WORKER_BATCH_SIZE=5
EXTRACTION_WORKER_IDLE_DELAY_MS=2000
EXTRACTION_WORKER_ERROR_DELAY_MS=10000
EXTRACTION_REQUEST_TIMEOUT_MS=60000

# Railway extraction adapter. Keep these server-side and use a different token
# for the worker-to-adapter connection and the adapter-to-engine connection.
EXTRACTION_ADAPTER_TOKEN=
EXTRACTION_ENGINE_URL=
EXTRACTION_ENGINE_TOKEN=
EXTRACTION_ENGINE_TIMEOUT_MS=60000
